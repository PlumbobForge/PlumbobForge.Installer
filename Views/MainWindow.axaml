<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PlumbobForge.Installer.ViewModels"
        x:Class="PlumbobForge.Installer.Views.MainWindow"
        x:DataType="vm:InstallerViewModel"
        Title="PlumbobForge Setup"
        Width="540" Height="420"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Icon="/Assets/appicon.ico">

    <!-- Clean Modern Window Frame (0 CornerRadius for Window Border) -->
    <Border Background="{StaticResource BgDark}"
            BorderBrush="{StaticResource BorderMain}"
            BorderThickness="1"
            CornerRadius="0">

        <Grid RowDefinitions="Auto,*">

            <!-- Title Bar (Flat Header, Clean Borderless App Icon) -->
            <Border Grid.Row="0" Background="{StaticResource BgHeader}" Height="38"
                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1"
                    PointerPressed="OnHeaderPointerPressed">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- App Icon & Title (Original Brand Icon, No Background) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="9">
                        <Image Source="/Assets/appicon.png" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="PlumbobForge Setup" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Native-style Window Control Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <Button Classes="win-btn" Click="OnMinimizeClick" ToolTip.Tip="Minimize">
                            <PathIcon Data="{StaticResource IconMinus}" Width="10" Height="10" Foreground="{StaticResource TextMuted}"/>
                        </Button>
                        <Button Classes="win-btn win-btn-close" Click="OnCloseClick" ToolTip.Tip="Close">
                            <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10" Foreground="{StaticResource TextMuted}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="1">

                <!-- STEP 1: OPTIONS / DIRECTORY SELECTION -->
                <Grid IsVisible="{Binding IsWelcomeStep}" RowDefinitions="Auto,*,Auto" Margin="32,24,32,24">
                    <!-- Hero Section -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <PathIcon Data="{StaticResource IconAppLogo}" Width="48" Height="40"
                                      Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding TitleText}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                <TextBlock Text="Sims 3 CC Manager &amp; Merger" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Configuration Panels -->
                    <StackPanel Grid.Row="1" Spacing="16">
                        <!-- Path Selection (Rounded Box & Button) -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Installation Directory" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                            <Border Classes="input-box">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBox Grid.Column="0" Classes="seamless" Text="{Binding InstallDirectory}"/>
                                    <Button Grid.Column="1" Classes="secondary" Content="Browse" Height="30" Padding="14,0" FontSize="11"
                                            CornerRadius="6" VerticalAlignment="Center" Margin="6,0,0,0" Command="{Binding BrowseFolderCommand}"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Options Chips (Rounded) -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Options" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                            <WrapPanel Orientation="Horizontal">
                                <CheckBox Classes="chip" IsChecked="{Binding CreateDesktopShortcut}" Content="Desktop Shortcut" Margin="0,0,8,6"/>
                                <CheckBox Classes="chip" IsChecked="{Binding CreateStartMenuShortcut}" Content="Start Menu Shortcut" Margin="0,0,8,6"/>
                                <CheckBox Classes="chip" IsChecked="{Binding CleanupLegacyElectron}" IsVisible="{Binding HasLegacyElectron}" Content="Clean Legacy Electron Data" Margin="0,0,8,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Footer Actions (Rounded Action Buttons) -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button Grid.Column="0" Classes="secondary" Content="Cancel" Command="{Binding CancelCommand}"/>
                            <Button Grid.Column="2" Classes="primary" Content="{Binding InstallButtonText}" Command="{Binding StartInstallCommand}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- STEP 2: INSTALLING PROGRESS -->
                <Grid IsVisible="{Binding IsInstallingStep}" RowDefinitions="*,Auto" Margin="32,32,32,28">
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Width="440" Spacing="20">
                        <PathIcon Data="{StaticResource IconAppLogo}" Width="52" Height="44"
                                  Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>

                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="Installing PlumbobForge..." FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource TextMain}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Extracting application files..." FontSize="12"
                                       Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Progress Bar & Status Text -->
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="11"
                                           Foreground="{StaticResource TextSubtle}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding ProgressPercentText}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                            <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100"
                                         Height="6" CornerRadius="4" Background="{StaticResource BgCardAlt}"
                                         Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>

                        <!-- Cancel Installation Button -->
                        <Button Classes="secondary" Content="Cancel Installation" HorizontalAlignment="Center"
                                Height="32" Padding="14,0" FontSize="11" CornerRadius="6"
                                Command="{Binding RequestCancelCommand}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- STEP 3: FINISHED -->
                <Grid IsVisible="{Binding IsCompletedStep}" RowDefinitions="*,Auto" Margin="32,32,32,24">
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Width="420" Spacing="16">
                        <Border Width="64" Height="64" CornerRadius="32" Background="#09281c"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5"
                                HorizontalAlignment="Center">
                            <PathIcon Data="{StaticResource IconCheck}" Width="28" Height="28"
                                      Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="Ready to Use!" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextMain}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                                       Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Footer Actions -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <Button Grid.Column="1" Classes="secondary" Content="Close" Command="{Binding FinishCommand}" Margin="0,0,10,0"/>
                            <Button Grid.Column="2" Classes="primary" Content="Launch PlumbobForge" Command="{Binding LaunchAppCommand}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- STEP 4: ERROR / CANCELLED -->
                <Grid IsVisible="{Binding IsFailedStep}" RowDefinitions="*,Auto" Margin="32,32,32,24">
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Width="440" Spacing="16">
                        <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource StatusRedBg}"
                                BorderBrush="{StaticResource StatusRed}" BorderThickness="1.5"
                                HorizontalAlignment="Center">
                            <PathIcon Data="{StaticResource IconClose}" Width="28" Height="28"
                                      Foreground="{StaticResource StatusRed}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="Installation Failed" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource TextMain}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="400"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Footer Actions -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <Button Grid.Column="1" Classes="secondary" Content="Close" Command="{Binding CancelCommand}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- CONFIRM CANCEL POPUP MODAL OVERLAY -->
                <Grid IsVisible="{Binding ShowCancelConfirmation}" Background="#80000000">
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderMain}" BorderThickness="1"
                            CornerRadius="8" Width="380" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Cancel Installation?" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                            <TextBlock Text="Are you sure you want to cancel the installation? All files copied so far will be removed and no changes will be made to your system."
                                       FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" LineHeight="18"/>
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
                                <Button Grid.Column="1" Classes="secondary" Content="Continue Installing"
                                        Command="{Binding DismissCancelConfirmationCommand}" Margin="0,0,10,0"/>
                                <Button Grid.Column="2" Classes="danger" Content="Cancel &amp; Revert"
                                        Command="{Binding ConfirmCancelInstallationCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
